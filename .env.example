# ---------------------------------------------------------------------------
# Supabase (Auth + profiles) — PUBLIC keys only
# Never put service_role in EXPO_PUBLIC_* or commit it.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Store / pilot builds: hide demo Pro toggle (also hidden when __DEV__===false)
# EXPO_PUBLIC_STORE_BUILD=1

# Pluggable AI (horoscope / chat). When both set → real HTTP call; else mock.
# Contract: POST JSON { type, profile, traits?, date?, message?, history?, skipIntake? }
#   → { text, traits?, readyForReading? }
# EXPO_PUBLIC_AI_API_URL=https://van-su-ai-proxy.example.workers.dev
# EXPO_PUBLIC_AI_API_KEY=shared-bearer-not-openai-secret

# Legacy optional mock AI endpoint (no auth)
# EXPO_PUBLIC_MOCK_AI_URL=https://example.com/mock-ai

# AdMob (placeholders — use EAS secrets for production IDs)
# EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-xxxxx/yyyyy

# RevenueCat public SDK key (EAS secret for store builds)
# EXPO_PUBLIC_REVENUECAT_API_KEY=appl_or_goog_xxx
