# Optional mock AI endpoint for horoscope generation
# EXPO_PUBLIC_MOCK_AI_URL=https://example.com/mock-ai

# ---------------------------------------------------------------------------
# Supabase (Auth + profiles) — PUBLIC keys only
# Never put service_role in EXPO_PUBLIC_* or commit it.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

